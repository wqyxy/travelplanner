{
  "name": "ai-travel-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "cross-env TRAVEL_DEV=1 tsx watch apps/server/index-v3.ts",
    "dev:server": "cross-env TRAVEL_DEV=1 tsx watch apps/server/index-v3.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index-v3.js",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/build_portable_windows.ps1",
    "package:macos": "bash scripts/build_portable_macos.sh"
  },
  "dependencies": {
    "@openai/codex": "0.145.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "6.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "ws": "8.21.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.6",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
